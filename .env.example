# ─────────────────────────────────────────────────────────────
#  Deep Research AI — settings
#  Pick ONE model provider, plus Tavily for web search.
# ─────────────────────────────────────────────────────────────

# --- Model provider: Gemini (free tier alternative) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# A research run makes 10-25 model calls, so pick a model with free-tier
# headroom: gemini-3.6-flash allows only 20 requests PER DAY.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Model provider: OpenAI (default) ---
# https://platform.openai.com/api-keys
# Only needed if you select OpenAI in the sidebar. Note this is a paid API —
# there is no free tier, so a research run costs real money.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Which provider the sidebar starts on: gemini | openai
DEFAULT_PROVIDER=openai


# --- Web search (required for real research, whichever model you pick) ---
# The model does the reasoning; Tavily does the looking-up. Without this the
# agent cannot search and answers from model knowledge only.
# https://app.tavily.com
TAVILY_API_KEY=

# --- App password (gates the deployed Streamlit app) ---
# Anyone with this password can use the app and spend its API budget.
# Change it by editing this line; copy the same value into your Cloud secrets.
APP_PASSWORD=

# --- Tracing (optional): Langfuse observability ---
# See every model call, tool call and subagent delegation as one nested trace.
# Free tier at https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com


# ─────────────────────────────────────────────────────────────
#  Tuning (safe defaults — change only if you hit limits)
# ─────────────────────────────────────────────────────────────

# Basic | Standard | Advanced  (Basic is cheapest; Advanced makes the most calls)
RESEARCH_DEPTH=Standard

# Paces model calls so a burst does not trip per-minute quotas. Lower on 429s.
REQUESTS_PER_MINUTE=12
MAX_RETRIES=3
