# Streamlit Community Cloud: paste the contents of this file (with real values)
# into  Manage app -> Settings -> Secrets.  Do NOT commit the filled-in version.
#
# Locally you can keep using .env instead — the app reads the environment first
# and falls back to these secrets, so both work.

# --- Model provider: OpenAI (default) ---
OPENAI_API_KEY = "sk-proj-..."
OPENAI_MODEL = "gpt-5.4-mini"

# --- Model provider: Gemini (alternative, has a free tier) ---
GOOGLE_API_KEY = ""
GEMINI_MODEL = "gemini-3.1-flash-lite"

# --- Web search (needed for real research, whichever model you pick) ---
TAVILY_API_KEY = "tvly-..."

# --- App password (gates the deployed app) ---
APP_PASSWORD = "choose-a-long-random-string"

# --- Tracing (optional) --- https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY = "pk-lf-..."
LANGFUSE_SECRET_KEY = "sk-lf-..."
LANGFUSE_HOST = "https://cloud.langfuse.com"

# --- Defaults ---
DEFAULT_PROVIDER = "openai"
RESEARCH_DEPTH = "Standard"
REQUESTS_PER_MINUTE = "12"
MAX_RETRIES = "3"
